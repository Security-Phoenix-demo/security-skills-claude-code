{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "FULL hooks preset — combines the bundle's 3 active hooks (SessionStart fingerprint, PreToolUse Bash package guard, PostToolUse pattern quickscan) with the lite SessionEnd 0-day reminder. Merge the 'hooks' block into your project's .claude/settings.json. The __SUITE_DIR__ placeholders are resolved to the plugin's absolute path by install/install.sh — substitute them yourself if you merge this by hand.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__SUITE_DIR__/hooks/session-start.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__SUITE_DIR__/hooks/pre-bash-package-guard.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__SUITE_DIR__/hooks/post-edit-quickscan.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__SUITE_DIR__/install/hooks/session-end-security-0day.sh\""
          }
        ]
      }
    ]
  }
}
